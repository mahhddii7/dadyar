# Cloud model provider: openai-compatible | ollama | none
AI_PROVIDER=openai-compatible
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b

# OpenAI-compatible API (OpenAI, Arvan, or another compatible provider)
# Use the exact base URL, API key, and model name supplied by your provider.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=

# Optional persistent workspace directory
DATA_DIR=./data

# Optional: only enable JSON mode if supported by the configured provider.
AI_JSON_MODE=false
AI_MAX_STEPS=7

# Optional OCR: images/scanned PDF pages are sent to the configured vision API.
# Requires AI_PROVIDER=openai-compatible and a vision-capable model ID.
AI_OCR_ENABLED=false
AI_VISION_MODEL=
